@startuml
title Kullanım Senaryosu (Use Case Diagram)
left to right direction
actor "Kullanıcı" as User

package "Podcast & Müzik Paneli" {
  usecase "Listeyi Görüntüle" as UC1
  usecase "Podcast/Müzik Ara" as UC2
  usecase "Müzik Oynat" as UC3
  usecase "Yeni Podcast Ekle" as UC4
  usecase "URL Geçerliliğini Kontrol Et" as UC5
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

UC4 ..> UC5 : <<include>>
@enduml


@startuml
title Sınıf Diyagramı (Class Diagram)

class Podcast {
  - baslik: String
  - sanatci: String
  - ses_yolu: String
  - kategori: String
  - sure: String
  + bilgileri_getir(): Dictionary
}

class PodcastListesi {
  - liste_adi: String
  - podcastler: List<Podcast>
  + podcast_ekle(podcast: Podcast): void
  + listeyi_getir(): List<Podcast>
}

PodcastListesi "1" *-- "many" Podcast : içerir >
@enduml